<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>FrozenSnowFox.FrozenSnowFoxComplexJobs</modId>
		<key>FSFSelfTendWorktype</key>
		<defaultValue>false</defaultValue>
		<caseTrue>
			
		<Operation Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				
			<!-- Self Tend Worktype -->
			
			<li MayRequire="Ludeon.RimWorld.Biotech" Class="PatchOperationAdd">
				<xpath>/Defs</xpath>
				<value>
					
  <WorkTypeDef>
    <defName>FSFSelfTend</defName>
    <labelShort>self tend</labelShort>
    <pawnLabel>Doctor</pawnLabel>
    <gerundLabel>doctoring</gerundLabel>
    <description>Perform first aid on themselves.</description>
    <verb>Care for</verb>
    <naturalPriority>1355</naturalPriority>
    <relevantSkills>
      <li>Medicine</li>
    </relevantSkills>
    <workTags>
      <li>Caring</li>
      <li>Commoner</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>
					
				</value>
			</li>
				
			<!-- Biotech Mechanoids Patch -->
			
			<li MayRequire="Ludeon.RimWorld.Biotech" Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef/race/mechEnabledWorkTypes [li [text()="Doctor"] ]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef/race/mechEnabledWorkTypes [li [text()="Doctor"] ]</xpath>
					<value>
						<li>FSFSelfTend</li>
					</value>
				</match>
			</li>
				
			<li MayRequire="Ludeon.RimWorld.Biotech,imranfish.xmlextensions" Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef/race/mechEnabledWorkTypes [li [text()="Doctor"] ]</xpath>
				<match Class="XmlExtensions.PatchOperationSafeAddOrReplace">
					<xpath>/Defs/ThingDef/race [mechEnabledWorkTypes/li [text()="Doctor"] ]</xpath>
					<compare>Both</compare>
					<value>
						<mechWorkTypePriorities>
							<FSFSelfTend>3</FSFSelfTend>
						</mechWorkTypePriorities>
					</value>
				</match>
			</li>
				
		<!-- ABF Artificial Beings Framework Patch -->
			
			<li MayRequire="Ludeon.RimWorld.Biotech,Killathon.ArtificialBeings" Class="PatchOperationConditional">		
				<xpath>/Defs/AlienRace.ThingDef_AlienRace/modExtensions/li[@Class = "ArtificialBeings.ABF_ArtificialPawnExtension"]/inherentWorkTypes [li [text()="Doctor"] ]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace/modExtensions/li[@Class = "ArtificialBeings.ABF_ArtificialPawnExtension"]/inherentWorkTypes [li [text()="Doctor"] ]</xpath>
					<value>
						<li>FSFSelfTend</li>
					</value>
				</match>
			</li>
			
			<li MayRequire="Ludeon.RimWorld.Biotech,Killathon.ArtificialBeings" Class="PatchOperationConditional">		
				<xpath>/Defs/AlienRace.ThingDef_AlienRace/modExtensions/li[@Class = "ArtificialBeings.ABF_ArtificialPawnExtension"]/forbiddenWorkTypes [li [text()="Doctor"] ]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace/modExtensions/li[@Class = "ArtificialBeings.ABF_ArtificialPawnExtension"]/forbiddenWorkTypes [li [text()="Doctor"] ]</xpath>
					<value>
						<li>FSFSelfTend</li>
					</value>
				</match>
			</li>
				
			<!-- Asimov Automation Patch -->
			
			<li MayRequire="Ludeon.RimWorld.Biotech,Neronix17.Asimov" Class="PatchOperationConditional">		
				<xpath>/Defs/ThingDef/comps/li[@Class = "Asimov.CompProperties_Automaton"]/enabledWorkTypes [li [text()="Doctor"] ]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef/comps/li[@Class = "Asimov.CompProperties_Automaton"]/enabledWorkTypes [li [text()="Doctor"] ]</xpath>
					<value>
						<li>FSFSelfTend</li>
					</value>
				</match>
			</li>
				
			<!-- Change Task Worktype -->
				
			<li Class="PatchOperationReplace">
				<xpath>/Defs/WorkGiverDef[@Name = "DoctorTendToSelf"]/workType</xpath>
				<value>
					<workType>FSFSelfTend</workType>
				</value>
			</li>
				
			<!-- Add Worktype to Human for Children -->
			
			<li MayRequire="Ludeon.RimWorld.Biotech" Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName = "Human"]/race/lifeStageWorkSettings</xpath>
				<value>
					<FSFSelfTend>10</FSFSelfTend> <!-- Default Childcare 10 -->
				</value>
			</li>
				
			<!-- Vanilla Races Expanded - Archon -->
				
			<li MayRequire="Ludeon.RimWorld.Biotech" Class="PatchOperationConditional">		
				<xpath>/Defs/GeneDef[defName="VRE_EarlyMaturity"]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/GeneDef[defName = "VRE_EarlyMaturity"]/modExtensions/li[@Class = "VREArchon.LifeStageWorkSettingsExtension"]/lifeStageWorkSettings</xpath>
					<value>
						<FSFSelfTend>7</FSFSelfTend> <!-- VRE_EarlyMaturity Childcare 7 -->
					</value>
				</match>
			</li>
				
			</operations>
		</Operation>
			
		</caseTrue>
	</Operation>

</Patch>